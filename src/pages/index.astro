---
import BaseLayout from '../layouts/BaseLayout.astro';
const phone='[TK — pull from Yelp listing]';
const services=[['Drywall Installation & Repair','Water intrusion, freeze damage, settlement cracks, texture matching and popcorn ceiling removal.','/drywall-installation-repair-houston/'],['Custom Fireplace Walls','Built-in focal walls, finish upgrades and custom fireplace surrounds made for the room.','/custom-fireplace-walls-houston/'],['Kitchen Remodeling','Practical kitchen updates, custom layouts, cabinets, surfaces, tile and finish work.','/kitchen-remodeling-houston/'],['Bathroom Remodeling','Showers, tile, vanities, wall finishes and moisture-conscious bathroom rebuilds.','/bathroom-remodeling-houston/'],['Interior & Exterior Painting','Residential and commercial prep, repairs and paint selected for Gulf Coast conditions.','/interior-exterior-painting-houston/'],['Stone Walkways & Hardscaping','Stone paths, garden borders and exterior upgrades planned around grade, access and drainage.','/stone-walkways-hardscaping-houston/'],['Commercial Remodeling','Focused build-outs and interior improvements for Houston-area businesses.','/commercial-remodeling-houston/']];
const schema={'@context':'https://schema.org','@type':'GeneralContractor',name:'OilerBilt Home Remodeling',areaServed:['Houston','Alief','Mission Bend','Sugar Land','Katy','Missouri City'].map(name=>({'@type':'Place',name})),sameAs:['https://www.instagram.com/oilerbilt/']};
---
<BaseLayout title="Houston Remodeling Contractor | OilerBilt" description="OilerBilt handles drywall, kitchens, bathrooms, painting and custom remodeling across Houston and southwest Harris County. Request an estimate." {schema}>
<section class="hero"><div class="hero-inner wrap"><p class="eyebrow">Houston built. Homeowner focused.</p><h1>Remodeling that works for Houston homes.</h1><p class="hero-copy">OilerBilt Home Remodeling handles focused repairs and full room updates across Houston and southwest Harris County. Tell us what is failing, dated or unfinished. We’ll talk through the job and the next step.</p><div class="actions"><a class="button" href="/free-estimate/">Request a free estimate</a><a class="button secondary" href={`tel:${phone}`}>Call {phone}</a></div></div></section>
<div class="trust-strip wrap"><div><strong>Southwest Houston based</strong>Alief, Mission Bend and the wider metro</div><div><strong>Residential + commercial</strong>Repairs, room remodels and finish work</div><div><strong>Straightforward estimates</strong>Scope, variables and next steps explained</div></div>
<section id="services"><div class="wrap"><div class="section-head"><div><p class="eyebrow">What we do</p><h2>Repairs and remodels with a clear scope.</h2></div><p>Houston houses ask a lot of their interiors. Humidity, storm water, freeze-related pipe failures and slab movement all leave marks. OilerBilt works from the damage underneath to the finish you see every day.</p></div><div class="service-grid">{services.map(([name,copy,href])=><a class="service-card" href={href}><h3>{name}</h3><p>{copy}</p><span>See the service →</span></a>)}</div></div></section>
<section class="band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">A calmer project</p><h2>Know what happens next.</h2></div><p>Remodeling is disruptive enough without guessing who is coming, what gets opened up or when a decision is needed. The process starts with the actual condition of the space.</p></div><div class="process"><article><h3>Talk through it</h3><p>Describe the job, the damage or the room you want to update.</p></article><article><h3>See the space</h3><p>We look at access, existing conditions and the work behind the finish.</p></article><article><h3>Confirm scope</h3><p>You get a clear project scope and the variables that can change it.</p></article><article><h3>Build + walk through</h3><p>Work is completed, cleaned up and reviewed with you.</p></article></div></div></section>
<section><div class="wrap"><div class="section-head"><div><p class="eyebrow">Real OilerBilt work</p><h2>Project photography is coming from the source.</h2></div><p>We won’t pass off a stock kitchen as somebody else’s work. This area is reserved for OilerBilt’s original Instagram project exports once the client provides full-resolution files and confirms locations.</p></div><div class="photo-placeholder">[TK — Add approved OilerBilt project photos from original files; strip EXIF before publishing]</div></div></section>
<section class="cta-band"><div class="wrap cta-grid"><div><p class="eyebrow" style="color:white">Start with the job in front of you</p><h2>Tell us what needs work.</h2><p>Send a few details and a photo if you have one. We’ll follow up about the space, service area and a practical time to look at it.</p><p><strong>Prefer to talk?</strong><br /><a href={`tel:${phone}`}>{phone}</a></p></div><form class="estimate-form" name="estimate" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data"><input type="hidden" name="form-name" value="estimate" /><p hidden><label>Don’t fill this out: <input name="bot-field" /></label></p><label>Name<input required name="name" autocomplete="name" /></label><label>Phone<input required type="tel" name="phone" autocomplete="tel" /></label><label>Email<input required type="email" name="email" autocomplete="email" /></label><label>Service<select name="service"><option>Drywall repair</option><option>Kitchen remodeling</option><option>Bathroom remodeling</option><option>Painting</option><option>Custom fireplace wall</option><option>Stone walkway / exterior upgrade</option><option>Commercial remodeling</option></select></label><label>Project description<textarea required name="description"></textarea></label><label>Project photo<input type="file" name="photo" accept="image/*" /></label><button class="button" type="submit">Request my estimate</button></form></div></section>
</BaseLayout>
