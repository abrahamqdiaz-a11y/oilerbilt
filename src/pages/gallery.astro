---
import BaseLayout from '../layouts/BaseLayout.astro';
const cats=['All','Kitchen','Bathroom','Drywall','Fireplace','Painting','Exterior','Commercial'];
---
<BaseLayout title="OilerBilt Remodeling Project Gallery" description="Browse OilerBilt kitchen, bathroom, drywall, fireplace, painting and exterior remodeling projects in the Houston area."><div class="page-hero"><div class="wrap"><div class="breadcrumbs"><a href="/">Home</a> / Gallery</div><p class="eyebrow">Project gallery</p><h1>Real work, with honest captions.</h1><p>Only approved OilerBilt project photography will be published here.</p></div></div><section><div class="wrap"><div class="filter-bar" role="group" aria-label="Filter projects">{cats.map(c=><button type="button" data-filter={c.toLowerCase()}>{c}</button>)}</div><div class="gallery-grid" id="gallery">{cats.slice(1).map(c=><figure data-cat={c.toLowerCase()}><div class="photo-placeholder">[TK — {c} project image]</div><figcaption>{c} project caption, location and scope awaiting client confirmation.</figcaption></figure>)}</div></div></section><script>document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;document.querySelectorAll<HTMLElement>('#gallery figure').forEach(item=>item.hidden=filter!=='all'&&item.dataset.cat!==filter);document.querySelectorAll('[data-filter]').forEach(b=>b.removeAttribute('aria-pressed'));button.setAttribute('aria-pressed','true')}));</script></BaseLayout>
