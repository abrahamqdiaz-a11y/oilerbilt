---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
const cats = [
  "All",
  "Kitchen",
  "Bathroom",
  "Drywall",
  "Fireplace",
  "Painting",
  "Exterior",
  "Commercial",
  "Interior",
];
const images = [
  {
    base: "drywall-ceiling-damage-houston-03",
    alt: "Ceiling opened to expose framing and insulation before drywall repair",
    caption:
      "Damaged ceiling opened so the cavity and framing can be inspected before rebuilding.",
    category: "Drywall",
  },
  {
    base: "drywall-ceiling-patch-houston-01",
    alt: "Large ceiling drywall patch taped and coated during repair",
    caption:
      "New ceiling board taped and coated as the repair moves toward texture and paint.",
    category: "Drywall",
  },
  {
    base: "drywall-texture-repair-houston-02",
    alt: "Ceiling texture blended above an interior doorway",
    caption:
      "Ceiling texture after repair and blending above an interior doorway.",
    category: "Drywall",
  },
  {
    base: "interior-floor-removal-houston-01",
    alt: "Interior hallway after old tile flooring was removed",
    caption:
      "Old tile removed from an entry hall during interior remodeling preparation.",
    category: "Interior",
  },
  {
    base: "bathroom-demolition-houston-01",
    alt: "Houston bathroom during demolition with shower walls opened to framing",
    caption:
      "Bathroom demolition exposing shower framing, insulation and plumbing routes.",
    category: "Bathroom",
  },
  {
    base: "bathroom-demolition-houston-02",
    alt: "Close view of shower area opened to studs during bathroom remodel",
    caption:
      "Shower area opened to the studs so existing conditions can be seen before reconstruction.",
    category: "Bathroom",
  },
];
---

<BaseLayout
  title="OilerBilt Remodeling Project Gallery"
  description="Browse OilerBilt kitchen, bathroom, drywall, fireplace, painting and exterior remodeling projects in the Houston area."
>
  <div class="page-hero">
    <div class="wrap">
      <div class="breadcrumbs">
        <a href="/">Home</a> / Gallery
      </div>
      <p class="eyebrow">Project gallery</p>
      <h1>Real work, with honest captions.</h1>
      <p>Only approved OilerBilt project photography will be published here.</p>
    </div>
  </div>
  <section>
    <div class="wrap">
      <div class="filter-bar" role="group" aria-label="Filter projects">
        {cats.map((c) => (
          <button type="button" data-filter={c.toLowerCase()}>
            {c}
          </button>
        ))}
      </div>
      <div id="gallery">
        <ProjectGallery {images} />
      </div>
    </div>
  </section>
  <script>
    document
      .querySelectorAll<HTMLButtonElement>("[data-filter]")
      .forEach((button) =>
        button.addEventListener("click", () => {
          const filter = button.dataset.filter;
          document
            .querySelectorAll<HTMLElement>("#gallery figure")
            .forEach(
              (item) =>
                (item.hidden = filter !== "all" && item.dataset.cat !== filter),
            );
          document
            .querySelectorAll("[data-filter]")
            .forEach((b) => b.removeAttribute("aria-pressed"));
          button.setAttribute("aria-pressed", "true");
        }),
      );
  </script>
</BaseLayout>
