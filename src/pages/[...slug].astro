---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EstimateForm from "../components/EstimateForm.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
export function getStaticPaths() {
  return Promise.all([
    getCollection("services"),
    getCollection("locations"),
  ]).then(([s, l]) => [
    ...s.map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry, type: "service" },
    })),
    ...l.map((entry) => ({
      params: { slug: `service-areas/${entry.data.slug}` },
      props: { entry, type: "location" },
    })),
  ]);
}
const { entry, type } = Astro.props;
const { Content } = await render(entry);
const isService = type === "service";
const faqSchema = isService
  ? {
      "@type": "FAQPage",
      mainEntity: entry.data.faqs.map((f: any) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;
const serviceSchema = isService
  ? {
      "@type": "Service",
      name: entry.data.title,
      description: entry.data.seoDescription,
      url: Astro.url.href,
      serviceType: entry.data.title,
      areaServed: { "@type": "Place", name: "Houston, Texas" },
      provider: { "@id": `${new URL("/", Astro.site ?? Astro.url.origin).href}#organization` },
    }
  : null;
const schema = {
  "@graph": [
    ...(isService ? [serviceSchema, faqSchema] : []),
  ],
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  breadcrumbLabel={entry.data.title}
  breadcrumbParent={{
    name: isService ? "Services" : "Service Areas",
    url: isService ? "/#services" : "/service-areas/",
  }}
  {schema}
>
  <div class="page-hero">
    <div class="wrap">
      <div class="breadcrumbs">
        <a href="/">Home</a> /{" "}
        <a href={isService ? "/#services" : "/service-areas/"}>
          {isService ? "Services" : "Service areas"}
        </a>{" "}
        / {entry.data.title}
      </div>
      <p class="eyebrow">
        {isService ? entry.data.eyebrow : "Southwest Houston service area"}
      </p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="actions">
        <a class="button" href="/free-estimate/">
          Request an estimate
        </a>
        <a class="text-link" href="tel:+14692492563">
          Call (469) 249-2563
        </a>
      </div>
    </div>
  </div>
  <article class="article wrap">
    <Content />
  </article>
  {isService ? (
    <>
      <section class="band">
        <div class="wrap">
          <p class="eyebrow">Scope</p>
          <h2>What’s included</h2>
          <div class="check-grid">
            {entry.data.included.map((x: string) => (
              <div>✓ {x}</div>
            ))}
          </div>
        </div>
      </section>
      <section>
        <div class="wrap">
          <p class="eyebrow">From estimate to walkthrough</p>
          <h2>A process you can follow</h2>
          <div class="process">
            <article>
              <h3>Initial call</h3>
              <p>
                We ask what you want changed, what is damaged and where the
                project is located.
              </p>
            </article>
            <article>
              <h3>Site review</h3>
              <p>
                We inspect access and existing conditions, including anything
                that may be hidden behind finishes.
              </p>
            </article>
            <article>
              <h3>Scope + choices</h3>
              <p>
                We define the work and identify material or layout decisions
                needed before work begins.
              </p>
            </article>
            <article>
              <h3>Work + cleanup</h3>
              <p>
                The project moves through preparation, installation and finish
                work with cleanup built in.
              </p>
            </article>
            <article>
              <h3>Walkthrough</h3>
              <p>
                We review the completed scope together and note anything that
                still needs attention.
              </p>
            </article>
          </div>
        </div>
      </section>
      <section class="dark-band">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Project photos</p>
              <h2>Real OilerBilt work.</h2>
            </div>
            <p>
              {entry.data.images?.length
                ? "Work-in-progress photos show what happens behind the finish, where important repair decisions are made."
                : "[TK — Add approved original project images with honest captions and confirmed location context.]"}
            </p>
          </div>
          {entry.data.images?.length ? (
            <ProjectGallery images={entry.data.images} />
          ) : (
            <div class="photo-placeholder">
              Photography awaiting client-provided originals
            </div>
          )}
        </div>
      </section>
      <section>
        <div class="wrap">
          <p class="eyebrow">Estimate variables</p>
          <h2>What affects project cost</h2>
          <p>
            No two existing spaces open up the same way. We do not publish a
            made-up price range before seeing the job. These are the factors
            that most often change the scope:
          </p>
          <div class="check-grid">
            {entry.data.cost.map((x: string) => (
              <div>{x}</div>
            ))}
          </div>
        </div>
      </section>
      <section class="band">
        <div class="wrap narrow">
          <p class="eyebrow">Common questions</p>
          <h2>Before you schedule</h2>
          <div class="faq-list">
            {entry.data.faqs.map((f: any) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
      <section>
        <div class="wrap">
          <div class="link-grid">
            <div>
              <h2>Related services</h2>
              {entry.data.related.map((x: any) => (
                <a href={x.href}>{x.label} →</a>
              ))}
            </div>
            <div>
              <h2>Nearby service areas</h2>
              {entry.data.locations.map((x: any) => (
                <a href={x.href}>{x.label} →</a>
              ))}
            </div>
          </div>
        </div>
      </section>
    </>
  ) : (
    <section class="band">
      <div class="wrap">
        <h2>Remodeling services in this area</h2>
        <div class="service-grid">
          {entry.data.services.map((x: any) => (
            <a class="service-card" href={x.href}>
              <h3>{x.label}</h3>
              <span>See service →</span>
            </a>
          ))}
        </div>
        <p>
          <strong>Neighborhoods and local references:</strong>{" "}
          {entry.data.neighborhoods.join(", ")}.
        </p>
      </div>
    </section>
  )}
  {isService && (
    <section>
      <div class="wrap article" style="padding-top:0">
        <h2>Working in an occupied Houston property</h2>
        <p>
          Most remodeling happens while somebody still lives or works in the
          building. Before the start date, we identify the route into the work
          area, where tools and material can be staged, which rooms need
          protection, and when water or power could be interrupted. Pets,
          children, customer traffic and home-office schedules belong in that
          conversation. Containment reduces dust, but it does not make
          demolition silent or erase every inconvenience.
        </p>
        <p>
          Material decisions also need a cutoff. A late change to tile, paint,
          fixtures or layout can affect lead time, preparation and work already
          completed. When the requested scope changes, the added or removed work
          should be described before it proceeds. The same applies to a
          concealed condition discovered after a wall, cabinet or finish comes
          out. We pause at the affected area, show what is visible and discuss
          the practical options rather than quietly covering it or surprising
          the customer at closeout.
        </p>
        <h2>Cleanup, punch lists and warranty questions</h2>
        <p>
          Daily cleanup and final cleanup are different. During active work, the
          goal is to keep paths usable, control debris and leave the work zone
          in a reasonable condition for the stage of construction. Final cleanup
          follows the last sanding, coating or installation work. The estimate
          should make clear what protection, hauling and disposal are included,
          especially when access is tight or heavy material must move through an
          occupied space.
        </p>
        <p>
          A final walkthrough checks the agreed scope at normal viewing distance
          and under the room’s typical light. Touchups and incomplete items go
          on a punch list with a clear path to completion. Warranty language is
          not published on this site because it has not yet been confirmed by
          the client. Ask about the warranty that applies to the specific work
          and materials in your estimate; manufacturer coverage and contractor
          workmanship coverage are not automatically the same thing.
        </p>
        <p>
          Houston weather can affect schedules. Exterior coatings, stone work
          and any repair that depends on dry conditions should not be forced
          through a rain or humidity window simply to protect a date. Interior
          work after a leak also needs the cavity to be dry before it closes. A
          realistic schedule accounts for those conditions, required inspections
          and material availability instead of promising a finish date before
          the project has been seen.
        </p>
      </div>
    </section>
  )}
  <section class="cta-band">
    <div class="wrap cta-grid">
      <div>
        <p class="eyebrow" style="color:white">
          Next step
        </p>
        <h2>Show us the space.</h2>
        <p>
          Send a short description and a photo if you have one. We’ll follow up
          about the location, project scope and a time to take a closer look.
        </p>
      </div>
      <EstimateForm />
    </div>
  </section>
</BaseLayout>
