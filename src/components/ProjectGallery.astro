---
import { jpegSize } from "../lib/image-size";
interface ProjectImage {
  base: string;
  alt: string;
  caption: string;
  category?: string;
}
interface Props {
  images: ProjectImage[];
  /** Marks the first photo as the likely LCP element. */
  priority?: boolean;
}
const { images, priority = false } = Astro.props;
const items = images.map((image) => ({
  ...image,
  src: `/images/${image.base}-1200.jpg`,
  ...jpegSize(`/images/${image.base}-1200.jpg`),
}));
---

<div class="project-gallery">
  {items.map((image, index) => (
    <figure data-cat={image.category?.toLowerCase()}>
      <picture>
        <source
          type="image/webp"
          srcset={`/images/${image.base}-640.webp 640w, /images/${image.base}-1200.webp 1200w`}
          sizes="(max-width: 700px) 100vw, 50vw"
        />
        <source
          type="image/jpeg"
          srcset={`/images/${image.base}-640.jpg 640w, /images/${image.base}-1200.jpg 1200w`}
          sizes="(max-width: 700px) 100vw, 50vw"
        />
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading={priority && index === 0 ? "eager" : "lazy"}
          fetchpriority={priority && index === 0 ? "high" : undefined}
          decoding="async"
        />
      </picture>
      <figcaption>{image.caption}</figcaption>
    </figure>
  ))}
</div>
