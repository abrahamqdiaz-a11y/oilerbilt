---
import { getCollection } from "astro:content";
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  breadcrumbLabel?: string;
  breadcrumbParent?: { name: string; url: string };
}
const {
  title,
  description,
  schema,
  noindex: suppliedNoindex,
  breadcrumbLabel,
  breadcrumbParent,
} = Astro.props;
const noindex = suppliedNoindex ?? Astro.url.pathname === "/thank-you/";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const siteUrl = new URL("/", Astro.site ?? Astro.url.origin).href;
const imageUrl = new URL("/og.png", siteUrl).href;
const logoUrl = new URL("/oilerbilt-logo.png", siteUrl).href;
const nav = [
  ["Services", "/#services"],
  ["Gallery", "/gallery/"],
  ["Service areas", "/service-areas/"],
  ["About", "/about/"],
  ["Contact", "/contact/"],
];
const phone = "(469) 249-2563";
const phoneHref = "tel:+14692492563";
const email = "oilerbilt@gmail.com";
const areaServed = [
  "Houston",
  "Alief",
  "Mission Bend",
  "Sugar Land",
  "Katy",
  "Missouri City",
];
const serviceEntries = (await getCollection("services")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const providedSchema = schema
  ? (Array.isArray(schema) ? schema : [schema]).flatMap((item: any) =>
      item["@graph"] ?? [item],
    )
  : [];
const pathLabels: Record<string, string> = {
  about: "About",
  contact: "Contact",
  "free-estimate": "Free Estimate",
  gallery: "Project Gallery",
  "service-areas": "Service Areas",
  "thank-you": "Request Received",
};
const segments = Astro.url.pathname.split("/").filter(Boolean);
const parentUrl = breadcrumbParent
  ? new URL(breadcrumbParent.url, siteUrl)
  : segments.length > 1
    ? new URL(`/${segments[0]}/`, siteUrl)
    : null;
// A parent whose URL resolves to the homepage (for example the "/#services"
// anchor) would repeat position 1, so it is left out of the structured chain.
const parentCrumb =
  parentUrl && parentUrl.pathname !== "/"
    ? {
        "@type": "ListItem",
        name: breadcrumbParent?.name ?? pathLabels[segments[0]] ?? segments[0],
        item: parentUrl.href,
      }
    : null;
const breadcrumbItems = segments.length
  ? [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      ...(parentCrumb ? [{ ...parentCrumb, position: 2 }] : []),
      {
        "@type": "ListItem",
        position: parentCrumb ? 3 : 2,
        name: breadcrumbLabel ?? pathLabels[segments.at(-1) ?? ""] ?? title.split(" |")[0],
        item: canonical.href,
      },
    ]
  : [];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "OilerBilt Home Remodeling",
      url: siteUrl,
      inLanguage: "en-US",
      publisher: { "@id": `${siteUrl}#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical.href}#webpage`,
      name: title,
      description,
      url: canonical.href,
      isPartOf: { "@id": `${siteUrl}#website` },
      about: { "@id": `${siteUrl}#organization` },
      inLanguage: "en-US",
    },
    {
      "@type": ["Organization", "GeneralContractor"],
      "@id": `${siteUrl}#organization`,
      name: "OilerBilt Home Remodeling",
      alternateName: "OilerBilt",
      url: siteUrl,
      description:
        "Residential and commercial remodeling contractor serving Houston and southwest Harris County, Texas.",
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
        width: 580,
        height: 300,
      },
      image: imageUrl,
      telephone: "+1-469-249-2563",
      email,
      // Service-area business operating from a private residence: locality and
      // region only. Never publish a street address here.
      address: {
        "@type": "PostalAddress",
        addressLocality: "Houston",
        addressRegion: "TX",
        addressCountry: "US",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer service",
        telephone: "+1-469-249-2563",
        email,
        areaServed: "US",
        availableLanguage: "English",
      },
      areaServed: areaServed.map((name) => ({
        "@type": "City",
        name,
        containedInPlace: { "@type": "State", name: "Texas" },
      })),
      knowsAbout: serviceEntries.map((entry) => entry.data.title),
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Remodeling services",
        itemListElement: serviceEntries.map((entry) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: entry.data.title,
            url: new URL(`/${entry.data.slug}/`, siteUrl).href,
          },
        })),
      },
      sameAs: ["https://www.instagram.com/oilerbilt/"],
      // No aggregateRating, review, priceRange, foundingDate, award or
      // license claim is published: none of those facts are verified yet.
    },
    ...(breadcrumbItems.length
      ? [{ "@type": "BreadcrumbList", itemListElement: breadcrumbItems }]
      : []),
    ...providedSchema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta
      name="google-site-verification"
      content="E_mpaqjIFXg3l3oVSdn113O_NEOOmCF6XFEzrY5Mo9o"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OilerBilt Home Remodeling" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={imageUrl}
    />
    <meta
      property="og:image:alt"
      content="OilerBilt Home Remodeling — Houston and southwest Harris County"
    />
    <meta property="og:image:width" content="1734" />
    <meta property="og:image:height" content="907" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={imageUrl}
    />
    <meta name="twitter:image:alt" content="OilerBilt Home Remodeling in Houston" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="OilerBilt Home Remodeling home">
          <picture>
            <source srcset="/oilerbilt-logo.webp" type="image/webp" />
            <img class="brand-logo" src="/oilerbilt-logo.png" alt="OilerBilt Home Remodeling" width="580" height="300" />
          </picture>
        </a>
        <nav aria-label="Primary navigation">
          {nav.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
        <a class="header-call" href={phoneHref}>
          Call {phone}
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-grid wrap">
        <div>
          <a class="brand footer-brand" href="/" aria-label="OilerBilt Home Remodeling home">
            <picture>
              <source srcset="/oilerbilt-logo.webp" type="image/webp" />
              <img class="brand-logo" src="/oilerbilt-logo.png" alt="OilerBilt Home Remodeling" width="580" height="300" loading="lazy" />
            </picture>
          </a>
          <p>Serving Houston and southwest Harris County.</p>
          <a
            class="yelp-link"
            href="https://www.yelp.com/search?find_desc=OilerBilt&find_loc=Houston%2C%20TX"
            rel="noopener noreferrer"
          >
            Find OilerBilt on Yelp →
          </a>
        </div>
        <div>
          <h2>Start a project</h2>
          <a href={phoneHref}>{phone}</a>
          <br />
          <a href={`mailto:${email}`}>{email}</a>
        </div>
        <div>
          <h2>Explore</h2>
          <a href="/gallery/">Project gallery</a>
          <br />
          <a href="/free-estimate/">Free estimate</a>
          <br />
          <a href="/service-areas/">Service areas</a>
          <br />
          <a href="/privacy-policy/">Privacy policy</a>
          <br />
          <a href="/terms-of-service/">Terms of service</a>
        </div>
      </div>
      <div class="legal wrap">
        © {new Date().getFullYear()} OilerBilt Home Remodeling. Service-area
        business; no public showroom.
      </div>
    </footer>
    <a class="mobile-call" href={phoneHref}>
      Call for a free estimate
    </a>
  </body>
</html>
